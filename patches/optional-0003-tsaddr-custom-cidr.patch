+// customTailnetRange is an optional IPv4 prefix for tailnet addresses outside
+// Tailscale's CGNAT range. Set TS_TAILNET_CIDR (e.g. 10.10.0.0/24) to enable.
+// When unset, behavior is unchanged.
+var customTailnetRange = func() netip.Prefix {
+	if s := os.Getenv("TS_TAILNET_CIDR"); s != "" {
+		if p, err := netip.ParsePrefix(s); err == nil {
+			return p
+		}
+	}
+	return netip.Prefix{}
+}()
